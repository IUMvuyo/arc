# Arc reads your week with GPT-5.6 via the OpenAI Responses API.
# Without a key, Arc still runs — it falls back to the baked demo narrative
# and a local heuristic analyzer, so the on-stage demo never depends on the network.

OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_MODEL=gpt-5.6

# Optional: cloud sync of your archive (accounts). If unset, Arc runs local-only
# and the archive still works in the browser. These Firebase web values are NOT
# secret; security is enforced by Firestore rules. See FIREBASE_SETUP.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
